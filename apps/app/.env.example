# The app's configuration (CON8). Expo reads `.env.local` from this folder;
# copy this file there and fill in the values. Everything here becomes part
# of the app, so never put a secret in it.

# The local stack, after `supabase start` and `./powersync/up.sh`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# `supabase status` prints this as PUBLISHABLE_KEY.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_POWERSYNC_URL=http://127.0.0.1:8080
