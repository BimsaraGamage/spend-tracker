{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": [".nvmrc", "pnpm-workspace.yaml"],
  // Strict mode hides undeclared variables from tasks. These only switch off
  // telemetry and interactive prompts, so they pass through without
  // affecting the cache.
  "globalPassThroughEnv": ["CI", "DO_NOT_TRACK", "EXPO_NO_TELEMETRY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": ["coverage/**"]
    }
  }
}
